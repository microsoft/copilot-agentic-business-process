# Normalise text files in the repository, checkout with platform-native endings.
* text=auto

# PowerShell is authored and run on Windows.
*.ps1 text eol=crlf
*.psm1 text eol=crlf

*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf

# Solution exports are generated by pac; never let git rewrite them.
business-processes/*/solution/export/** -text
core/solution/export/** -text

*.zip binary
*.png binary
*.drawio binary
