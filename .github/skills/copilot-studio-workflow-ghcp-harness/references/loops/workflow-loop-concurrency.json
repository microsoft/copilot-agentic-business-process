              "properties": {},
              "required": []
            }
          },
          "metadata": {
            "associatedData": {
              "graph": {
                "name": "loop-with-concurrency",
                "nodes": [
                  {
                    "id": "start",
                    "name": "Manual Trigger",
                    "type": "start",
                    "version": 1,
                    "position": {
                      "x": 100,
