              },
              "nodeActionMapping": {
                "node-1": [
                  "Initialize_numbers__array_sum",
                  "Initialize_numbers__array_sum_Init_array_sum"
                ],
                "node-3": [
                  "Increment_array_sum"
                ],
                "node-2": [
                  "ForEach_number"
                ],
                "builtinFunction-7ea04bed-7c2a-4085-b0c1-9e71766324b1": [
                  "Show_array_sum"
                ]
              },
