            }
          }
        }
      },
      "actions": {
        "Initialize_numbers__array_sum": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "numbers",
                "type": "Array",
                "value": [
                  1,
                  5,
                  10
                ]
              }
            ]
          },
          "metadata": {
            "description": "Initialize numbers, array_sum",
            "nodeId": "node-1"
          }
        },
        "Initialize_numbers__array_sum_Init_array_sum": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "array_sum",
                "type": "Integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Initialize_numbers__array_sum": [
              "Succeeded"
            ]
          }
        },
        "ForEach_number": {
          "type": "Foreach",
          "foreach": "@coalesce(variables('numbers'), json('[]'))",
          "actions": {
            "Increment_array_sum": {
              "type": "IncrementVariable",
              "inputs": {
                "name": "array_sum",
                "value": "@add(items('ForEach_number'), 1)"
              },
              "metadata": {
                "description": "Increment array_sum",
                "nodeId": "node-3"
              }
            }
          },
          "metadata": {
            "description": "ForEach_number",
            "nodeId": "node-2"
          },
          "runAfter": {
            "Initialize_numbers__array_sum_Init_array_sum": [
              "Succeeded"
            ]
          }
        },
        "Show_array_sum": {
          "type": "Compose",
          "inputs": "@variables('array_sum')",
          "runAfter": {
            "ForEach_number": [
              "Succeeded"
            ]
          },
          "metadata": {
            "description": "Show array sum",
            "nodeId": "builtinFunction-7ea04bed-7c2a-4085-b0c1-9e71766324b1"
          }
        }
      },
